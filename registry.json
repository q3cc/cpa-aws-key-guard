{
  "schema_version": 2,
  "plugins": [
    {
      "id": "aws-key-guard",
      "name": "AWS Key Guard",
      "description": "Adaptive AIMD per-key RPM rate limiter ('Too much usage'), passive invalid security token disabler, and auto-retry with 2-failures-then-switch-key orchestrator for AWS Bedrock / OpenAI-compatible pools.",
      "author": "q3cc",
      "version": "0.4.3",
      "repository": "https://github.com/q3cc/cpa-aws-key-guard",
      "tags": [
        "aws",
        "bedrock",
        "rate-limit",
        "rpm",
        "autoban",
        "scheduler",
        "retry",
        "failover"
      ],
      "locales": {
        "zh-CN": {
          "name": "AWS Key 守护、自适应限流与自动重试换 Key",
          "description": "默认不限流；遇到 Too much usage 自动按单 Key 自适应 AIMD 限流，遇到无效 security token 被动秒级禁用；请求失败自动重试（同 Key 连续失败 2 次后第 3 次切换下一个 Key，支持流式与非流式）。"
        }
      },
